<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the SWapp icon: straight to a new video. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_video"
        android:enabled="true"
        android:icon="@drawable/ic_send"
        android:shortcutShortLabel="@string/new_video">
        <intent android:action="android.intent.action.VIEW" android:data="swappsend://pick"
            android:targetPackage="com.southwestdigital.send"
            android:targetClass="com.southwestdigital.send.MainActivity" />
    </shortcut>
</shortcuts>
