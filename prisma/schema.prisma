  CEO
}

enum TicketCoordinationLevel {
  NONE
  ONE_EMAIL_REPLY
  ONE_EMAIL_IN_PERSON
  ONE_EMAIL_VIRTUAL
  TWO_TO_FIVE_EMAILS
