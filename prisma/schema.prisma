  updatedAt             DateTime         @updatedAt

  @@unique([brandId, key])
  @@index([brandId, type, isActive])
}

model PipelineStage {
  id              String         @id @default(cuid())
  pipelineId      String
  key             String
  name            String
  description     String?
  sortOrder       Int            @default(100)
  valueMultiplier Decimal        @default(0.01) @db.Decimal(6, 3)
