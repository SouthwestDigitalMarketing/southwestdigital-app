generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum PlatformRole {
  NONE
  ADMIN
  OWNER
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum BrandStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  OFFBOARDING
  DELETED
}

enum BrandRole {
  VIEWER
  MEMBER
  ADMIN
  OWNER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum DomainPurpose {
  APP
  WEBSITE
}

enum DomainStatus {
  PENDING
  VERIFIED
  DISABLED
}

enum IntegrationProvider {
  GA4
  GTM
  META_ADS
  GOOGLE_SEARCH_CONSOLE
  GOOGLE_ADS
  CLOUDFLARE
  STRIPE
  PAYPAL
  YOUTUBE
  QUO
  SANITY
  OTHER
}

enum IntegrationStatus {
  DISCONNECTED
  PENDING
  ACTIVE
  ERROR
  SUSPENDED
}

enum AuditActorType {
  USER
  SYSTEM
}

enum CustomerStatus {
  PROSPECT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ContactStatus {
  ACTIVE
  ARCHIVED
}

enum MarketingConsentStatus {
  UNKNOWN
  GRANTED
  DENIED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
  ARCHIVED
}

enum AttributionTouchType {
  FIRST_TOUCH
  LAST_TOUCH
  CONVERSION
  OTHER
}

model User {
  id            String            @id @default(cuid())
  name          String?
  email         String            @unique
  emailVerified DateTime?
  image         String?
  status        UserStatus        @default(INVITED)
  platformRole  PlatformRole      @default(NONE)
  accounts      Account[]
  sessions      Session[]
  memberships   BrandMembership[]
  auditEvents   AuditEvent[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status])
  @@index([platformRole])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Brand {
  id                     String                 @id @default(cuid())
  slug                   String                 @unique
  name                   String
  legalName              String?
  status                 BrandStatus            @default(DRAFT)
  subscriptionStartedAt  DateTime?
  subscriptionEndedAt    DateTime?
  accessEndsAt           DateTime?
  dataExportedAt         DateTime?
  retentionEndsAt        DateTime?
  deletedAt              DateTime?
  domains                BrandDomain[]
  memberships            BrandMembership[]
  theme                  BrandTheme?
  features               BrandFeature[]
  integrations           BrandIntegration[]
  auditEvents            AuditEvent[]
  customerAccounts       CustomerAccount[]
  contacts               Contact[]
  leads                  Lead[]
  customerContacts       CustomerContact[]
  leadContacts           LeadContact[]
  leadAttributionTouches LeadAttributionTouch[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([status])
}

model BrandDomain {
  id         String        @id @default(cuid())
  brandId    String
  hostname   String        @unique
  purpose    DomainPurpose @default(APP)
  status     DomainStatus  @default(PENDING)
  isPrimary  Boolean       @default(false)
  verifiedAt DateTime?
  brand      Brand         @relation(fields: [brandId], references: [id], onDelete: Restrict)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([brandId, purpose, status])
}

model BrandMembership {
  id        String           @id @default(cuid())
  brandId   String
  userId    String
  role      BrandRole        @default(MEMBER)
  status    MembershipStatus @default(INVITED)
  brand     Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([brandId, userId])
  @@index([brandId, status, role])
  @@index([userId, status])
}

model BrandTheme {
  id              String   @id @default(cuid())
  brandId         String   @unique
  logoUrl         String?
  logoAlt         String?
  primaryColor    String   @default("#17324d")
  accentColor     String   @default("#d79b3b")
  backgroundColor String   @default("#f7f8fa")
  foregroundColor String   @default("#17202a")
  supportEmail    String?
  brand           Brand    @relation(fields: [brandId], references: [id], onDelete: Restrict)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BrandFeature {
  id         String    @id @default(cuid())
  brandId    String
  key        String
  enabled    Boolean   @default(false)
  settings   Json?
  enabledAt  DateTime?
  disabledAt DateTime?
  brand      Brand     @relation(fields: [brandId], references: [id], onDelete: Restrict)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([brandId, key])
  @@index([brandId, enabled])
}

model BrandIntegration {
  id               String              @id @default(cuid())
  brandId          String
  key              String
  provider         IntegrationProvider
  status           IntegrationStatus   @default(DISCONNECTED)
  displayName      String?
  publicConfig     Json?
  secretCiphertext String?             @db.Text
  secretKeyVersion Int?
  secretReference  String?
  lastVerifiedAt   DateTime?
  lastErrorAt      DateTime?
  lastErrorCode    String?
  brand            Brand               @relation(fields: [brandId], references: [id], onDelete: Restrict)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([brandId, key])
  @@index([brandId, provider, status])
}

model AuditEvent {
  id           String         @id @default(cuid())
  brandId      String?
  actorUserId  String?
  actorType    AuditActorType
  action       String
  resourceType String?
  resourceId   String?
  requestId    String?
  ipHash       String?
  metadata     Json?
  occurredAt   DateTime       @default(now())
  brand        Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  actorUser    User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([brandId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([resourceType, resourceId, occurredAt])
}

model CustomerAccount {
  id                          String            @id @default(cuid())
  brandId                     String
  code                        String?
  name                        String
  legalName                   String?
  status                      CustomerStatus    @default(PROSPECT)
  websiteUrl                  String?
  entityType                  String?
  principalAddressLine1       String?
  principalAddressLine2       String?
  principalAddressCity        String?
  principalAddressRegion      String?
  principalAddressPostalCode  String?
  principalAddressCountryCode String?
  primaryPhone                String?
  communicationEmail          String?
  noticesEmail                String?
  invoicingEmail              String?
  customFields                Json?
  brand                       Brand             @relation(fields: [brandId], references: [id], onDelete: Restrict)
  contacts                    CustomerContact[]
  convertedLeads              Lead[]
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt

  @@unique([brandId, id])
  @@unique([brandId, code])
  @@index([brandId, status, name])
  @@index([brandId, createdAt])
}

model Contact {
  id                     String                 @id @default(cuid())
  brandId                String
  displayName            String
  firstName              String?
  lastName               String?
  email                  String?
  normalizedEmail        String?
  secondaryEmail         String?
  businessEmail          String?
  personalEmail          String?
  phoneE164              String?
  phoneNumber            String?
  roleTitle              String?
  status                 ContactStatus          @default(ACTIVE)
  marketingConsent       MarketingConsentStatus @default(UNKNOWN)
  marketingConsentAt     DateTime?
  marketingConsentSource String?
  customFields           Json?
  brand                  Brand                  @relation(fields: [brandId], references: [id], onDelete: Restrict)
  customerLinks          CustomerContact[]
  leadLinks              LeadContact[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@unique([brandId, id])
  @@index([brandId, status, displayName])
  @@index([brandId, normalizedEmail])
  @@index([brandId, createdAt])
}

model CustomerContact {
  id                String          @id @default(cuid())
  brandId           String
  customerAccountId String
  contactId         String
  relationship      String?
  isPrimary         Boolean         @default(false)
  brand             Brand           @relation(fields: [brandId], references: [id], onDelete: Restrict)
  customerAccount   CustomerAccount @relation(fields: [brandId, customerAccountId], references: [brandId, id], onDelete: Restrict)
  contact           Contact         @relation(fields: [brandId, contactId], references: [brandId, id], onDelete: Restrict)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([brandId, customerAccountId, contactId])
  @@index([brandId, contactId])
  @@index([brandId, customerAccountId, isPrimary])
}

model Lead {
  id                  String                 @id @default(cuid())
  brandId             String
  convertedCustomerId String?
  name                String
  company             String?
  email               String?
  normalizedEmail     String?
  phoneE164           String?
  status              LeadStatus             @default(NEW)
  source              String?
  sourceDetail        String?
  expectedServices    String?
  notes               String?
  estimatedValue      Decimal?               @db.Decimal(14, 2)
  valueCurrency       String?                @db.VarChar(3)
  lostReason          String?
  convertedAt         DateTime?
  customFields        Json?
  brand               Brand                  @relation(fields: [brandId], references: [id], onDelete: Restrict)
  convertedCustomer   CustomerAccount?       @relation(fields: [brandId, convertedCustomerId], references: [brandId, id], onDelete: Restrict)
  contacts            LeadContact[]
  attributionTouches  LeadAttributionTouch[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@unique([brandId, id])
  @@index([brandId, status, createdAt])
  @@index([brandId, normalizedEmail])
  @@index([brandId, source, createdAt])
  @@index([brandId, convertedCustomerId])
}

model LeadContact {
  id        String   @id @default(cuid())
  brandId   String
  leadId    String
  contactId String
  role      String?
  isPrimary Boolean  @default(false)
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Restrict)
  lead      Lead     @relation(fields: [brandId, leadId], references: [brandId, id], onDelete: Restrict)
  contact   Contact  @relation(fields: [brandId, contactId], references: [brandId, id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brandId, leadId, contactId])
  @@index([brandId, contactId])
  @@index([brandId, leadId, isPrimary])
}

model LeadAttributionTouch {
  id             String               @id @default(cuid())
  brandId        String
  leadId         String
  touchType      AttributionTouchType @default(OTHER)
  source         String?
  medium         String?
  campaign       String?
  term           String?
  content        String?
  landingPageUrl String?
  referrerUrl    String?
  gclid          String?
  gbraid         String?
  wbraid         String?
  fbclid         String?
  msclkid        String?
  metaCampaignId String?
  metaAdSetId    String?
  metaAdId       String?
  metadata       Json?
  capturedAt     DateTime             @default(now())
  brand          Brand                @relation(fields: [brandId], references: [id], onDelete: Restrict)
  lead           Lead                 @relation(fields: [brandId, leadId], references: [brandId, id], onDelete: Restrict)

  @@index([brandId, leadId, capturedAt])
  @@index([brandId, source, medium, capturedAt])
  @@index([brandId, campaign, capturedAt])
  @@index([brandId, fbclid])
  @@index([brandId, gclid])
}
