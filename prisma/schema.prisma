  enabledAt  DateTime?
  disabledAt DateTime?
  brand      Brand     @relation(fields: [brandId], references: [id], onDelete: Restrict)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([brandId, key])
  @@index([brandId, enabled])
}

model BrandIntegration {
  id                 String                @id @default(cuid())
  brandId            String
  key                String
  provider           IntegrationProvider
  status             IntegrationStatus     @default(DISCONNECTED)
  assetOwner         IntegrationAssetOwner @default(BRAND)
  displayName        String?
  externalAccountId  String?
  externalPropertyId String?
  publicIdentifier   String?
  notes              String?               @db.Text
  publicConfig       Json?
  secretCiphertext   String?               @db.Text
  secretKeyVersion   Int?
  secretReference    String?
  lastVerifiedAt     DateTime?
  lastErrorAt        DateTime?
  lastErrorCode      String?
  brand              Brand                 @relation(fields: [brandId], references: [id], onDelete: Restrict)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([brandId, key])
  @@index([brandId, provider, status])
  @@index([brandId, assetOwner])
}

model AgreementTemplate {
  id          String    @id @default(cuid())
  brandId     String
  key         String
  name        String
  description String?
  content     String    @db.Text
  status      String    @default("active")
  isDefault   Boolean   @default(false)
  archivedAt  DateTime?
  brand       Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([brandId, key])
  @@index([brandId, status, name])
  @@index([brandId, isDefault, status])
}

model AuditEvent {
  id           String         @id @default(cuid())
  brandId      String?
  actorUserId  String?
  actorType    AuditActorType
  action       String
  resourceType String?
  resourceId   String?
  requestId    String?
  ipHash       String?
  metadata     Json?
  occurredAt   DateTime       @default(now())
  brand        Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  actorUser    User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([brandId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([resourceType, resourceId, occurredAt])
}

model CustomerAccount {
  id                 String            @id @default(cuid())
  brandId            String
  code               String?
  name               String
  legalName          String?
  status             CustomerStatus    @default(PROSPECT)
  websiteUrl         String?
  communicationEmail String?
  primaryPhone       String?
  noticesEmail       String?
  invoicingEmail     String?
  customFields       Json?
  brand              Brand             @relation(fields: [brandId], references: [id], onDelete: Restrict)
  contacts           CustomerContact[]
  convertedLeads     Lead[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([brandId, id])
  @@unique([brandId, code])
  @@index([brandId, status, name])
  @@index([brandId, createdAt])
}

model CustomerContact {
  id                String          @id @default(cuid())
  brandId           String
  customerAccountId String
  contactId         String
  relationship      String?
  isPrimary         Boolean         @default(false)
  brand             Brand           @relation(fields: [brandId], references: [id], onDelete: Restrict)
  customerAccount   CustomerAccount @relation(fields: [brandId, customerAccountId], references: [brandId, id], onDelete: Restrict)
  contact           Contact         @relation(fields: [brandId, contactId], references: [brandId, id], onDelete: Restrict)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([brandId, customerAccountId, contactId])
  @@index([brandId, contactId])
  @@index([brandId, customerAccountId, isPrimary])
}

model Lead {
  id                  String                 @id @default(cuid())
  brandId             String
  convertedCustomerId String?
  name                String
  company             String?
  email               String?
  normalizedEmail     String?
  phoneE164           String?
  status              LeadStatus             @default(NEW)
  source              String?
  sourceDetail        String?
  expectedServices    String?
  notes               String?
  estimatedValue      Decimal?               @db.Decimal(14, 2)
  valueCurrency       String?                @db.VarChar(3)
  customFields        Json?
  brand               Brand                  @relation(fields: [brandId], references: [id], onDelete: Restrict)
  convertedCustomer   CustomerAccount?       @relation(fields: [brandId, convertedCustomerId], references: [brandId, id], onDelete: Restrict)
  attributionTouches  LeadAttributionTouch[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@unique([brandId, id])
  @@index([brandId, status, createdAt])
  @@index([brandId, normalizedEmail])
}

model LeadAttributionTouch {
  id             String               @id @default(cuid())
  brandId        String
  leadId         String
  touchType      AttributionTouchType @default(OTHER)
  source         String?
  medium         String?
  campaign       String?
  term           String?
  content        String?
  landingPageUrl String?
  capturedAt     DateTime             @default(now())
  brand          Brand                @relation(fields: [brandId], references: [id])
  lead           Lead                 @relation(fields: [brandId, leadId], references: [brandId, id])

  @@index([brandId, leadId, capturedAt])
}

model BrandOffboardingPlan {
  id                String                @id @default(cuid())
  brandId           String
  status            OffboardingPlanStatus @default(PLANNED)
  serviceEndsAt     DateTime
  accessEndsAt      DateTime
  retentionEndsAt   DateTime
  reason            String?               @db.Text
  initiatedByUserId String?
  startedAt         DateTime?
  cancelledAt       DateTime?
  completedAt       DateTime?
  brand             Brand                 @relation(fields: [brandId], references: [id])
  initiatedBy       User?                 @relation("OffboardingInitiator", fields: [initiatedByUserId], references: [id])
  dataExports       BrandDataExport[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([brandId, status])
}

model BrandDataExport {
  id                String                 @id @default(cuid())
  brandId           String
  offboardingPlanId String?
  requestedByUserId String?
  status            BrandDataExportStatus  @default(REQUESTED)
  format            BrandDataExportFormat  @default(JSONL_ZIP_V1)
  requestedScopes   BrandDataExportScope[]
  manifestVersion   Int                    @default(1)
  storageProvider   String?
  storageKey        String?
  checksumSha256    String?
  byteSize          BigInt?
  requestedAt       DateTime               @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  expiresAt         DateTime?
  failureCode       String?
  brand             Brand                  @relation(fields: [brandId], references: [id])
  offboardingPlan   BrandOffboardingPlan?  @relation(fields: [offboardingPlanId], references: [id])
  requestedBy       User?                  @relation("DataExportRequester", fields: [requestedByUserId], references: [id])
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([brandId, status, requestedAt])
}
