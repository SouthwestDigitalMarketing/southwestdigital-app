  fullFeeDueUpfront                  Boolean                 @default(false)
  discoveryRequired                  Boolean                 @default(true)
  discoveryCompletedAt               DateTime?
  finalScopeConfirmedAt              DateTime?
  revisedFeeAmount                   Decimal?
  changeOrderRequired                Boolean                 @default(false)
  periodStart                        DateTime?
  periodEnd                          DateTime?
  taxYearsInvolved                   String?
  accountsIncluded                   String?
  creditCardsIncluded                String?
  loansIncluded                      String?
  payrollInvolved                    Boolean                 @default(false)
  contractorPaymentsInvolved         Boolean                 @default(false)
  missingRecordsKnown                String?
  knownProblems                      String?
  requiredDocuments                  String?
  deliverables                       String?
  specialReportingPeriodStart        DateTime?
  specialReportingPeriodEnd          DateTime?
  specialReportDescription           String?
  auditPolicyOrLenderSupportRequired Boolean                 @default(false)
  agreementText                      String?
  agreementSentAt                    DateTime?
  agreementTokenHash                 String?
  signerName                         String?
  signerTitle                        String?
  signedAt                           DateTime?
  signerIpAddress                    String?
  signerUserAgent                    String?
  agreementTextHash                  String?
  consentToElectronicSignature       Boolean                 @default(false)
  agreementReadAndAgreed             Boolean                 @default(false)
  agreementScrolledToEnd             Boolean                 @default(false)
  agreementScrolledAt                DateTime?
  agreementNotes                     String?
  isTestProposal                     Boolean                 @default(false)
  discoveryTokenHash                 String?
  createdByMembershipId              String?
  createdAt                          DateTime                @default(now())
  updatedAt                          DateTime                @updatedAt
  discoveryItems                     DiscoveryItem[]
  proposalDocuments                  ProposalDocument[]
  assignedOwner                      BrandMembership?        @relation("EngagementAssignedOwner", fields: [assignedOwnerMembershipId], references: [id], onDelete: SetNull)
  internalReviewer                   BrandMembership?        @relation("EngagementInternalReviewer", fields: [internalReviewerMembershipId], references: [id], onDelete: SetNull)
  createdBy                          BrandMembership?        @relation("EngagementCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: SetNull)

  @@index([brandId, status, engagementType])
  @@index([assignedOwnerMembershipId])
  @@index([createdAt])
}

model DiscoveryItem {
  id           String     @id @default(cuid())
  engagementId String
  category     String     @default("General")
  label        String
  instructions String?
  status       String     @default("PENDING")
  clientNote   String?
  fileUrl      String?
  adminNote    String?
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@index([engagementId])
}

model ProposalDocument {
  id                      String            @id @default(cuid())
  brandId                 String
  engagementId            String?           @unique
  slug                    String            @unique
  companyName             String
  preparedFor             String
  serviceType             String
  cleanupPeriodStart      DateTime?
  cleanupPeriodEnd        DateTime?
  projectGoal             String
  estimatedTotalFee       Decimal?          @db.Decimal(12, 2)
  displayMode             String            @default("document")
  status                  String            @default("draft")
  publicStatus            String            @default("draft")
  paymentMethod           String?
  introPaymentSentence    String?
  acceptedAt              DateTime?
  acceptedByName          String?
  acceptedByEmail         String?
  acceptanceIp            String?
  acceptanceUserAgent     String?
  acceptanceNote          String?
  acceptedSnapshot        Json?
  agreementPreparedAt     DateTime?
  agreementSentAt         DateTime?
  agreementSignedAt       DateTime?
  phase3InvoiceSentAt     DateTime?
  phase3PaymentReceivedAt DateTime?
  phases                  ProposalPhase[]
  sections                ProposalSection[]
  engagement              Engagement?       @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@index([brandId, displayMode, status])
  @@index([publicStatus, slug])
  @@map("proposal_documents")
}

model ProposalPhase {
  id           String              @id @default(cuid())
  proposalId   String
  phaseNumber  Int
  title        String
  status       String              @default("pending")
  amount       Decimal?            @db.Decimal(12, 2)
  amountType   String              @default("fixed")
  paymentNote  String?
  introduction String?
  displayOrder Int                 @default(100)
  proposal     ProposalDocument    @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  items        ProposalPhaseItem[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([proposalId, displayOrder])
  @@map("proposal_phases")
}

model ProposalPhaseItem {
  id           String        @id @default(cuid())
  phaseId      String
  text         String
  displayOrder Int           @default(100)
  phase        ProposalPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([phaseId, displayOrder])
  @@map("proposal_phase_items")
}

model ProposalSection {
  id           String               @id @default(cuid())
  proposalId   String
  sectionKey   String
  title        String
  body         String?
  displayOrder Int                  @default(100)
  proposal     ProposalDocument     @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  items        ProposalSectionItem[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([proposalId, displayOrder])
  @@map("proposal_sections")
}

model ProposalSectionItem {
  id           String          @id @default(cuid())
  sectionId    String
  text         String
  displayOrder Int             @default(100)
  section      ProposalSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([sectionId, displayOrder])
  @@map("proposal_section_items")
}

model ProposalPackage {
  id                        String                   @id @default(cuid())
  brandId                   String
  key                       String
  scenario                  ProposalCatalogScenario
  name                      String
  summary                   String
  descriptionLong           String?
  supportLabel              String
  supportIncludes           String
  supportStars              Int                      @default(1)
  highlightLabel            String?
  tier                      Int                      @default(1)
  priceMode                 ProposalPackagePriceMode @default(BASE_MULTIPLIER)
  priceValue                Decimal?
  onboardingFee             Decimal?                 @db.Decimal(12, 2)
  billingType               String                   @default("recurring")
  whyItMatters              Json?
  displayOrder              Int                      @default(100)
  badge                     String?
  leadIn                    String?
  positioningStatement      String?
  buttonLabel               String?
  paymentStage1Label        String?
  paymentStage1Amount       Decimal?                 @db.Decimal(12, 2)
  paymentStage2Label        String?
  paymentStage2Amount       Decimal?                 @db.Decimal(12, 2)
  paymentStage3Label        String?
  paymentStage3Amount       Decimal?                 @db.Decimal(12, 2)
  clientResponsibilities    Json?
  exclusions                Json?
  responseStandard          String?
  expeditedCommitment       String?
  workingSessionLimit       Int?
  receiptLimit              Int?
  responseCommitmentTitle   String?
  responseCommitmentBody    String?
  onboardingSummary         String?
  onboardingItems           Json?
  executionSummary          String?
  executionItems            Json?
  expeditedAddOnPrice       Decimal?                 @db.Decimal(12, 2)
  expeditedAddOnLabel       String?
  expeditedAddOnDescription String?
  isActive                  Boolean                  @default(true)
  features                  ProposalPackageFeature[]
  packageServices           PackageService[]
  pricingRules              PricingRule[]
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  @@unique([brandId, key])
  @@index([brandId, scenario, isActive, displayOrder])
}

model ProposalPackageFeature {
  id              String              @id @default(cuid())
  packageId       String
  kind            ProposalFeatureKind @default(INCLUDED)
  shortLabel      String
  longDescription String?
  displayOrder    Int                 @default(100)
  package         ProposalPackage     @relation(fields: [packageId], references: [id], onDelete: Cascade)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([packageId, displayOrder])
}

model CatalogService {
  id                  String           @id @default(cuid())
  brandId             String
  code                String?
  name                String
  internalDescription String?          @map("description")
  cardLabel           String?          @map("card_label")
  clientBenefit       String?          @map("client_benefit")
  service             String           @default("cleanup") @map("itemType")
  category            String
  priority            Int              @default(500)
  defaultInclusion    String?          @map("default_inclusion")
  estimatedHours      Decimal?         @db.Decimal(6, 2)
  internalNotes       String?          @map("internal_notes")
  active              Boolean          @default(true)
  packageServices     PackageService[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([brandId, code])
  @@index([brandId, active, category])
  @@map("catalog_services")
}

model PackageService {
  id            String          @id @default(cuid())
  packageId     String
  serviceId     String
  inclusionType String          @default("included")
  notes         String?
  package       ProposalPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service       CatalogService  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt     DateTime        @default(now())

  @@unique([packageId, serviceId])
  @@index([packageId])
  @@index([serviceId])
  @@map("package_services")
}

model PricingRule {
  id          String          @id @default(cuid())
  packageId   String
  name        String          @default("")
  description String?
  ruleType    String
  configJson  Json
  billingType String          @default("recurring")
  minPrice    Decimal?        @db.Decimal(12, 2)
  maxPrice    Decimal?        @db.Decimal(12, 2)
  sortOrder   Int             @default(100)
  package     ProposalPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([packageId, sortOrder])
  @@map("pricing_rules")
}

model ProposalSelection {
  id                  String   @id @default(cuid())
  engagementId        String
  packageKey          String
  packageName         String
  selectedPrice       Decimal? @db.Decimal(12, 2)
  clientName          String?
  status              String   @default("pending")
  expeditedSelected   Boolean  @default(false)
  expeditedAddOnPrice Decimal? @db.Decimal(12, 2)
  selectedAt          DateTime @default(now())

  @@index([engagementId])
  @@map("proposal_selections")
}

// ─── Quotes ──────────────────────────────────────────────────────────────────

model QuoteClient {
  id        String   @id @default(cuid())
  brandId   String
  name      String
  email     String
  company   String?
  notes     String?
  quotes    Quote[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId, email])
  @@map("quote_clients")
}

model Quote {
  id             String          @id @default(cuid())
  brandId        String
  slug           String          @unique
  clientId       String
  status         String          @default("draft")
  packageId      String?
  totalOneTime   Decimal         @default(0) @db.Decimal(12, 2)
  totalRecurring Decimal         @default(0) @db.Decimal(12, 2)
  onboardingFee  Decimal         @default(0) @db.Decimal(12, 2)
  snapshotJson   Json
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  expiresAt      DateTime?
  client         QuoteClient     @relation(fields: [clientId], references: [id])
  lineItems      QuoteLineItem[]

  @@index([brandId, clientId, status])
  @@index([status, createdAt])
  @@map("quotes")
}

model QuoteLineItem {
  id          String   @id @default(cuid())
  quoteId     String
  label       String
  description String?
  amount      Decimal  @db.Decimal(12, 2)
  billingType String
  sortOrder   Int      @default(100)
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([quoteId, sortOrder])
  @@map("quote_line_items")
}

model QuoteTemplate {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  layoutType         String   @default("3-column")
  sections           Json     @default("[]")
  highlightMiddle    Boolean  @default(true)
  showInclusions     Boolean  @default(true)
  showPriceBreakdown Boolean  @default(true)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("quote_templates")
}

// ─── Firm & financial ─────────────────────────────────────────────────────────

model FirmProfile {
  id               String   @id @default(cuid())
  brandId          String   @unique
  legalName        String   @default("")
  dba              String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  postalCode       String?
  phone            String?
  email            String?
  ein              String?
  sosFileNumber    String?  @map("sos_file_number")
  stateOfFormation String?
  logoUrl          String?
  website          String?
  qboFirmId        String?  @map("qbo_firm_id")
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  @@map("firm_profile")
}

model CompanyRevenueMonth {
  id              String   @id @default(cuid())
  brandId         String
  monthStart      DateTime
  grossRevenueUsd Decimal  @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([brandId, monthStart])
  @@index([brandId])
}
