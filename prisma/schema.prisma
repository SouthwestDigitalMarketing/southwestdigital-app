enum LeadKind {
  LEAD
  PROSPECT
}

enum LeadBookkeepingCategory {
  SMALL_BUSINESS
  REAL_ESTATE_INVESTOR
  ECOMMERCE
  PROFESSIONAL_SERVICES
  OTHER
}

enum ReviewChannel {
  SMS
  EMAIL
  BOTH
}

enum ReviewOutcome {
  FIVE_STAR
  FEEDBACK
}

enum ContentCalendarStatus {
  PLANNED
  PRODUCED
  PUBLISHED
  CANCELLED
}

enum StandardsCheckStatus {
  HITTING
  NEEDS_WORK
  NA
  NOT_REVIEWED
}

enum EngagementType {
  MONTHLY_BOOKKEEPING
  CLEANUP_PROJECT
  CATCHUP_BOOKKEEPING
  HOURLY_WORK
  AUDIT_LENDER_CPA_SUPPORT
  REAL_ESTATE_CLOSING
  ADVISORY_CONSULTING
  OTHER
}

enum EngagementStatus {
  DRAFT
  READY_FOR_REVIEW
  SENT_TO_CLIENT
  SENT_FOR_SIGNATURE
  SIGNED
  INVOICE_SENT
  DEPOSIT_PAID
  ONBOARDING_STARTED
  ACTIVE
  COMPLETED
  TERMINATED
  INTAKE_SENT
  INTAKE_STARTED
  INTAKE_SUBMITTED
  INTAKE_REVIEWED
  READY_FOR_AGREEMENT
  AGREEMENT_GENERATED
  ONBOARDING_PAID
  DISCOVERY_STARTED
  VARIATION_PENDING
  VARIATION_SIGNED
  IN_PROGRESS
  QUESTIONS_PENDING
  REPORTS_IN_REVIEW
  DELIVERED
  COMPLETE
  PAUSED
  CANCELLED
}

enum EngagementPricingModel {
  FIXED_FEE
  HOURLY
  MONTHLY_RECURRING
  HYBRID
}

enum ScopingMode {
  AGREEMENT
  FULLY_SCOPED_FIXED_FEE
}

enum OnboardingFeeStatus {
  NOT_REQUIRED
  REQUIRED
  INVOICED
  PAID
  WAIVED
  INCLUDED_IN_PROJECT_FEE
}

enum FeeCreditTarget {
  DISCOVERY_DEPOSIT
  PROJECT_FEE
  NONE
}

enum DiscoveryDepositStatus {
  PENDING
  INVOICED
  PAID
  WAIVED
}

enum ProposalCatalogScenario {
  MONTHLY_BOOKKEEPING
  HISTORICAL_CLEANUP
  HOURLY_WORK
}

enum ProposalPackagePriceMode {
  BASE_MULTIPLIER
  FIXED
}

enum ProposalFeatureKind {
  INCLUDED
  UPGRADE
  SUPPORT
  TECH_REQUIREMENT
}

enum MemberEngagementType {
  W2_US
  CONTRACTOR_US_1099
  CONTRACTOR_INTL
}

enum MemberRoleProfile {
  BOOKKEEPER_INTERN
  BOOKKEEPER_EMPLOYEE
  ADMIN
  MEDIA
  OTHER
}

enum MemberRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum MemberI9Status {
  NOT_STARTED
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

enum MemberTaxStatus {
  NOT_REQUIRED
  NOT_STARTED
  SUBMITTED
  APPROVED
}

enum MemberTinType {
  SSN
  EIN
}

enum MemberPaymentMethod {
  WISE
  ACH
  CHECK
  PAYPAL
  OTHER
}

enum MemberPayCadence {
  WEEKLY
  BIWEEKLY
  MONTHLY
  ADHOC
}

enum MemberBackgroundCheckStatus {
  NOT_REQUIRED
  NOT_STARTED
  CONSENTED
  IN_PROGRESS
  PASSED
  FAILED
  NEEDS_REVIEW
}

enum MemberOnboardingStatus {
  INCOMPLETE
  PENDING_DOCS
  READY_TO_ACTIVATE
  ACTIVE
  INACTIVE
}

enum MemberDocumentType {
  I9_IDENTITY
  I9_WORK_AUTH
  W4
  W9
  CONTRACT
  NDA
  BACKGROUND_AUTH
  RESUME
  OTHER
}

enum OnboardingTrack {
  INTERN
  EMPLOYEE
  CONTRACTOR
}

// ─── Platform identity ────────────────────────────────────────────────────────

model User {
  id            String            @id @default(cuid())
  name          String?
  email         String            @unique
  emailVerified DateTime?
  image         String?
  status        UserStatus        @default(INVITED)
  platformRole  PlatformRole      @default(NONE)
  accounts      Account[]
  sessions      Session[]
  memberships   BrandMembership[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status])
  @@index([platformRole])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Brand / tenant ──────────────────────────────────────────────────────────

model Brand {
  id                    String            @id @default(cuid())
  slug                  String            @unique
  name                  String
  legalName             String?
  status                BrandStatus       @default(DRAFT)
  subscriptionStartedAt DateTime?
  subscriptionEndedAt   DateTime?
  accessEndsAt          DateTime?
  dataExportedAt        DateTime?
  retentionEndsAt       DateTime?
  deletedAt             DateTime?
  domains               BrandDomain[]
  memberships           BrandMembership[]
  theme                 BrandTheme?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([status])
}

model BrandDomain {
  id         String        @id @default(cuid())
  brandId    String
  hostname   String        @unique
  purpose    DomainPurpose @default(APP)
  status     DomainStatus  @default(PENDING)
  isPrimary  Boolean       @default(false)
  verifiedAt DateTime?
  brand      Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([brandId, purpose, status])
}

model BrandMembership {
  id                              String                    @id @default(cuid())
  brandId                         String
  userId                          String
  role                            BrandRole                 @default(MEMBER)
  status                          MembershipStatus          @default(INVITED)
  accountType                     AccountType?
  employeeNumber                  Int?
  isPayrollManager                Boolean                   @default(false)
  canAccessTickets                Boolean                   @default(false)
  canUseFocus                     Boolean                   @default(true)
  hasSeenFocusOnboarding          Boolean                   @default(false)
  brand                           Brand                     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user                            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  internProfile                   InternProfile?
  memberOnboardingProfile         MemberOnboardingProfile?
  agreementAcceptances            AgreementAcceptance[]
  onboardingSteps                 MemberOnboardingStep[]
  timecardEntries                 TimecardEntry[]
  timecardSessions                TimecardSession[]
  contractorInvoices              ContractorInvoice[]
  careerPathSteps                 CareerPathStep[]
  credentialBadges                MemberCredentialBadge[]
  memberDocuments                 MemberDocument[]          @relation("MemberDocuments")
  uploadedMemberDocuments         MemberDocument[]          @relation("MemberDocumentUploadedBy")
  memberAuditEvents               MemberAuditEvent[]        @relation("MemberAuditEvents")
  changedMemberAuditEvents        MemberAuditEvent[]        @relation("MemberAuditChangedBy")
  createdMemberOnboardingProfiles MemberOnboardingProfile[] @relation("MemberOnboardingCreatedBy")
  updatedMemberOnboardingProfiles MemberOnboardingProfile[] @relation("MemberOnboardingUpdatedBy")
  createdOnboardingInvites        OnboardingInvite[]        @relation("OnboardingInviteCreatedBy")
  linkedOnboardingInvite          OnboardingInvite?         @relation("OnboardingInviteLinkedMember")
  onboardingFlowAssignments       OnboardingFlowAssignment[]
  onboardingStepQuestions         OnboardingStepQuestion[]
  onboardingStepUploads           OnboardingStepUpload[]
  assignedTickets                 Ticket[]                  @relation("AssignedTickets")
  ticketComments                  TicketComment[]           @relation("TicketCommentAuthor")
  createdMeetings                 TeamMeeting[]             @relation("MeetingCreator")
  meetingAccess                   TeamMeetingAccess[]
  standardsChecks                 StandardsCheck[]
  reviewedStandardsChecks         StandardsCheck[]          @relation("StandardsCheckReviewedBy")
  dailyLogs                       DailyLog[]
  logItems                        LogItem[]
  focusQuotes                     FocusQuote[]
  focusQuoteSetting               FocusQuoteSetting?
  attendanceRecords               AttendanceRecord[]
  taskRecords                     TaskRecord[]
  assignedEngagements             Engagement[]              @relation("EngagementAssignedOwner")
  reviewedEngagements             Engagement[]              @relation("EngagementInternalReviewer")
  createdEngagements              Engagement[]              @relation("EngagementCreatedBy")
  sentReviewRequests              ReviewRequest[]           @relation("ReviewRequestSentBy")
  createdContentCalendarItems     ContentCalendarItem[]     @relation("ContentCalendarItemCreatedBy")
  createdPipelines                Pipeline[]                @relation("PipelineCreatedBy")
  createdClientIntakeInvites      ClientIntakeInvite[]      @relation("ClientIntakeInviteCreatedBy")
  createdAt                       DateTime                  @default(now())
  updatedAt                       DateTime                  @updatedAt

  @@unique([brandId, userId])
  @@unique([brandId, employeeNumber])
  @@index([brandId, status, role])
  @@index([userId, status])
}

model BrandTheme {
  id                String   @id @default(cuid())
  brandId           String   @unique
  logoUrl           String?
  logoAlt           String?
  primaryColor      String   @default("#17324d")
  accentColor       String   @default("#d79b3b")
  backgroundColor   String   @default("#f7f8fa")
  foregroundColor   String   @default("#17202a")
  supportEmail      String?
  monthlyViewsGoal  Int?
  monthlyClicksGoal Int?
  ga4PropertyId              String?
  ga4HostName                String?
  youtubeChannelId           String?
  youtubeWatchPercentageGoal Float?
  websiteEngagedSessionsGoal Int?
  brand             Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ─── Member profile data ─────────────────────────────────────────────────────

model InternProfile {
  id               String          @id @default(cuid())
  membershipId     String          @unique
  displayTitle     String?
  primaryEmail     String?
  timezone         String?
  startDate        DateTime?
  payRateUsd       Decimal?        @db.Decimal(10, 2)
  weeklyHoursCap   Decimal?        @db.Decimal(6, 2)
  nextRoleTitle    String?
  nextReviewDate   DateTime?
  nextLevelRateUsd Decimal?        @db.Decimal(10, 2)
  availability     String?
  workDays         String?
  workStartTime    String?
  workEndTime      String?
  telegramHandle   String?
  headshotUrl      String?
  shortBio         String?
  cohortLabel      String?
  deviceInfo       String?
  experienceNotes  String?
  goals            String?
  membership       BrandMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model MemberOnboardingProfile {
  id                         String                      @id @default(cuid())
  membershipId               String                      @unique
  legalFirstName             String
  legalLastName              String
  preferredName              String?
  dateOfBirth                DateTime?
  companyEmail               String?
  personalEmail              String?
  personalPhone              String?
  emergencyContactName       String?
  emergencyContactPhone      String?
  addressLine1               String?
  addressLine2               String?
  city                       String?
  region                     String?
  postalCode                 String?
  countryCode                String?
  engagementType             MemberEngagementType?
  memberRole                 MemberRoleProfile?
  riskLevel                  MemberRiskLevel?
  i9Required                 Boolean                     @default(false)
  i9Status                   MemberI9Status              @default(NOT_STARTED)
  i9DocumentTypes            Json?
  i9VerifiedAt               DateTime?
  w4Status                   MemberTaxStatus             @default(NOT_REQUIRED)
  w9Status                   MemberTaxStatus             @default(NOT_REQUIRED)
  tinLast4                   String?
  tinType                    MemberTinType?
  paymentMethod              MemberPaymentMethod?
  paymentEmailOrHandle       String?
  bankAccountToken           String?
  payCurrency                String                      @default("USD")
  payRate                    Float?
  payCadence                 MemberPayCadence?
  ndaAccepted                Boolean                     @default(false)
  ndaAcceptedAt              DateTime?
  handbookAccepted           Boolean                     @default(false)
  handbookAcceptedAt         DateTime?
  dataSecurityAccepted       Boolean                     @default(false)
  dataSecurityAcceptedAt     DateTime?
  contractAccepted           Boolean                     @default(false)
  contractAcceptedAt         DateTime?
  relationshipType           String?
  contractorType             String?
  w9QBAck                    Boolean                     @default(false)
  w9QBStatus                 String                      @default("NOT_SENT")
  w9QBNotes                  String?
  availableStartDate         DateTime?
  hoursPerWeek               Float?
  workingDays                Json?
  typicalHoursStart          String?
  typicalHoursEnd            String?
  timezone                   String?
  scheduleConflicts          String?
  canWorkUrgent              Boolean                     @default(false)
  canWorkWeekends            Boolean                     @default(false)
  scheduleNotes              String?
  scheduleAck                Boolean                     @default(false)
  paymentAck                 Boolean                     @default(false)
  paymentArrangement         String?
  projectNameProposal        String?
  projectAmountExpected      Float?
  projectDeadlineExpected    DateTime?
  projectNotesContractor     String?
  adminStatus                String                      @default("INVITED")
  sowRequired                Boolean                     @default(false)
  sowSent                    Boolean                     @default(false)
  sowSigned                  Boolean                     @default(false)
  approvedForWork            Boolean                     @default(false)
  adminNotes                 String?
  backgroundCheckRequired    Boolean                     @default(false)
  backgroundCheckConsent     Boolean                     @default(false)
  backgroundCheckConsentAt   DateTime?
  backgroundCheckStatus      MemberBackgroundCheckStatus @default(NOT_REQUIRED)
  backgroundCheckProviderRef String?
  needsQBOAccess             Boolean                     @default(false)
  needsEmailAccount          Boolean                     @default(false)
  needsTelegramAccess        Boolean                     @default(false)
  onboardingStatus           MemberOnboardingStatus      @default(INCOMPLETE)
  createdByMembershipId      String?
  updatedByMembershipId      String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  membership                 BrandMembership             @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdBy                  BrandMembership?            @relation("MemberOnboardingCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  updatedBy                  BrandMembership?            @relation("MemberOnboardingUpdatedBy", fields: [updatedByMembershipId], references: [id], onDelete: SetNull)

  @@map("member_onboarding_profiles")
}

model MemberDocument {
  id                     String             @id @default(cuid())
  membershipId           String
  docType                MemberDocumentType
  storageKey             String
  url                    String?
  checksum               String?
  uploadedByMembershipId String?
  uploadedAt             DateTime           @default(now())
  membership             BrandMembership    @relation("MemberDocuments", fields: [membershipId], references: [id], onDelete: Cascade)
  uploadedBy             BrandMembership?   @relation("MemberDocumentUploadedBy", fields: [uploadedByMembershipId], references: [id], onDelete: SetNull)

  @@index([membershipId, uploadedAt])
  @@map("member_documents")
}

model MemberAuditEvent {
  id                    String           @id @default(cuid())
  membershipId          String
  eventKey              String
  previousValue         String?
  newValue              String?
  changedByMembershipId String?
  createdAt             DateTime         @default(now())
  membership            BrandMembership  @relation("MemberAuditEvents", fields: [membershipId], references: [id], onDelete: Cascade)
  changedBy             BrandMembership? @relation("MemberAuditChangedBy", fields: [changedByMembershipId], references: [id], onDelete: SetNull)

  @@index([membershipId, createdAt])
  @@map("member_audit_events")
}

model OnboardingInvite {
  id                    String               @id @default(cuid())
  brandId               String
  tokenHash             String
  email                 String
  recipientName         String?
  role                  MemberRoleProfile
  onboardingTrack       OnboardingTrack
  engagementType        MemberEngagementType
  countryCode           String
  riskLevel             MemberRiskLevel
  backgroundCheckRequired Boolean
  needsQBOAccess        Boolean              @default(false)
  needsEmailAccount     Boolean              @default(false)
  needsTelegramAccess   Boolean              @default(true)
  uiVariant             String?
  lockedFields          Json?
  expiresAt             DateTime
  openedAt              DateTime?
  usedAt                DateTime?
  createdByMembershipId String?
  linkedMembershipId    String?              @unique
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  createdByMembership   BrandMembership?     @relation("OnboardingInviteCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  linkedMembership      BrandMembership?     @relation("OnboardingInviteLinkedMember", fields: [linkedMembershipId], references: [id], onDelete: SetNull)
  submissions           OnboardingSubmission[]

  @@index([brandId, email, createdAt])
}

model OnboardingSubmission {
  id                       String           @id @default(cuid())
  inviteId                 String
  submittedAt              DateTime         @default(now())
  ipAddress                String?
  userAgent                String?
  payloadSnapshotEncrypted String?
  invite                   OnboardingInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
}

model AgreementAcceptance {
  id               String          @id @default(cuid())
  membershipId     String
  agreementKey     String
  agreementVersion String
  acceptedAt       DateTime        @default(now())
  membership       BrandMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, agreementKey, agreementVersion])
}

model MemberOnboardingStep {
  id           String          @id @default(cuid())
  membershipId String
  stepKey      String
  completedAt  DateTime?
  membership   BrandMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, stepKey])
}

model OnboardingStepConfig {
  id                       String   @id @default(cuid())
  stepKey                  String   @unique
  titleOverride            String?
  descriptionOverride      String?
  streamIdOverride         String?
  linkHrefOverride         String?
  linkLabelOverride        String?
  agreementVersionOverride String?
  updatedAt                DateTime @updatedAt
  createdAt                DateTime @default(now())
}

model OnboardingFlow {
  id                String                     @id @default(cuid())
  brandId           String
  key               String
  label             String
  audience          OnboardingFlowAudience
  sortOrder         Int                        @default(100)
  isActive          Boolean                    @default(true)
  requireSequential Boolean                    @default(false)
  steps             OnboardingFlowStepConfig[]
  customSteps       OnboardingFlowCustomStep[]
  assignments       OnboardingFlowAssignment[]
  questions         OnboardingStepQuestion[]
  stepUploads       OnboardingStepUpload[]
  stepOrder         OnboardingFlowStepOrder[]
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@unique([brandId, key])
  @@index([brandId, audience, isActive, sortOrder])
}

model OnboardingFlowStepConfig {
  id                       String         @id @default(cuid())
  flowId                   String
  stepKey                  String
  titleOverride            String?
  descriptionOverride      String?
  streamIdOverride         String?
  linkHrefOverride         String?
  linkLabelOverride        String?
  assetHrefOverride        String?
  assetLabelOverride       String?
  objectivesOverride       String?
  agreementVersionOverride String?
  requiredOverride         Boolean?
  blockingOverride         Boolean?
  isEnabledOverride        Boolean?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  flow                     OnboardingFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([flowId, stepKey])
  @@index([flowId, stepKey])
}

model OnboardingFlowCustomStep {
  id               String             @id @default(cuid())
  flowId           String
  title            String
  description      String?
  type             OnboardingStepType
  required         Boolean            @default(false)
  blocking         Boolean            @default(false)
  sortOrder        Int                @default(1000)
  streamId         String?
  linkHref         String?
  linkLabel        String?
  assetHref        String?
  assetLabel       String?
  objectives       String?
  agreementKey     String?
  agreementVersion String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  flow             OnboardingFlow     @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@index([flowId, sortOrder, createdAt])
}

model OnboardingFlowAssignment {
  id                     String          @id @default(cuid())
  membershipId           String
  flowId                 String
  isActive               Boolean         @default(true)
  reviewModeEnabled      Boolean         @default(false)
  assignedByMembershipId String?
  assignedAt             DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  membership             BrandMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  flow                   OnboardingFlow  @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([membershipId, flowId])
  @@index([flowId, isActive])
  @@index([membershipId, isActive])
}

model OnboardingStepQuestion {
  id                     String                   @id @default(cuid())
  membershipId           String
  flowId                 String
  stepKey                String
  questionText           String
  status                 OnboardingQuestionStatus @default(OPEN)
  adminReplyText         String?
  askedAt                DateTime                 @default(now())
  answeredAt             DateTime?
  resolvedAt             DateTime?
  answeredByMembershipId String?
  updatedAt              DateTime                 @updatedAt
  membership             BrandMembership          @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  flow                   OnboardingFlow           @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([membershipId, flowId, stepKey])
  @@index([flowId, status])
  @@index([membershipId, status])
}

model OnboardingStepUpload {
  id              String          @id @default(cuid())
  membershipId    String
  flowId          String
  stepKey         String
  storageProvider String          @default("SUPABASE")
  bucket          String
  storagePath     String
  fileName        String
  mimeType        String?
  sizeBytes       Int
  publicUrl       String
  uploadedAt      DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  membership      BrandMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  flow            OnboardingFlow  @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([membershipId, flowId, stepKey])
  @@index([flowId, membershipId])
}

model OnboardingFlowStepOrder {
  id        String         @id @default(cuid())
  flowId    String
  stepKey   String
  sortOrder Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  flow      OnboardingFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([flowId, stepKey])
  @@index([flowId, sortOrder])
}

// ─── Timekeeping & payroll ───────────────────────────────────────────────────

model TimecardEntry {
  id           String          @id @default(cuid())
  membershipId String
  workDate     DateTime
  hours        Decimal         @db.Decimal(5, 2)
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
