// ─── Platform identity ────────────────────────────────────────────────────────

model User {
  id                        String                 @id @default(cuid())
  name                      String?
  email                     String                 @unique
  emailVerified             DateTime?
  image                     String?
  status                    UserStatus             @default(INVITED)
  platformRole              PlatformRole           @default(NONE)
  accounts                  Account[]
  sessions                  Session[]
  memberships               BrandMembership[]
  auditEvents               AuditEvent[]
  initiatedOffboardingPlans BrandOffboardingPlan[] @relation("OffboardingInitiator")
  requestedDataExports      BrandDataExport[]      @relation("DataExportRequester")
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  @@index([status])
  @@index([platformRole])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Brand / tenant ──────────────────────────────────────────────────────────

model Brand {
  id                     String                 @id @default(cuid())
  slug                   String                 @unique
  name                   String
  legalName              String?
  status                 BrandStatus            @default(DRAFT)
  subscriptionStartedAt  DateTime?
  subscriptionEndedAt    DateTime?
  accessEndsAt           DateTime?
  dataExportedAt         DateTime?
  retentionEndsAt        DateTime?
  deletedAt              DateTime?
  domains                BrandDomain[]
  memberships            BrandMembership[]
  theme                  BrandTheme?
  toolLinks              BrandToolLink[]
  media                  BrandMedia[]
  mediaFolders           BrandMediaFolder[]
  discounts              BrandDiscount[]
  crmContacts            Contact[]              @relation("CrmBrandContacts")
  contactTags            ContactTag[]
  contactTagAutomations  ContactTagAutomation[]
  relatedContactLinks    ContactBrandLink[]     @relation("ContactRelatedBrands")
  features               BrandFeature[]
  integrations           BrandIntegration[]
  agreementTemplates     AgreementTemplate[]
  auditEvents            AuditEvent[]
  customerAccounts       CustomerAccount[]
  leads                  Lead[]
  customerContacts       CustomerContact[]
  leadContacts           LeadContact[]
  leadAttributionTouches LeadAttributionTouch[]
  offboardingPlans       BrandOffboardingPlan[]
  dataExports            BrandDataExport[]
  catalogServices        CatalogService[]
  catalogServiceTags     CatalogServiceTag[]
  quoteRevisions         QuoteRevision[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([status])
}

model BrandDomain {
  id         String        @id @default(cuid())
  brandId    String
  hostname   String        @unique
  purpose    DomainPurpose @default(APP)
  status     DomainStatus  @default(PENDING)
  isPrimary  Boolean       @default(false)
  verifiedAt DateTime?
  brand      Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([brandId, purpose, status])
}

model BrandMembership {
  id                              String                     @id @default(cuid())
  brandId                         String
  userId                          String
  role                            BrandRole                  @default(MEMBER)
  status                          MembershipStatus           @default(INVITED)
  accountType                     AccountType?
  employeeNumber                  Int?
  isPayrollManager                Boolean                    @default(false)
  canAccessTickets                Boolean                    @default(false)
  canUseFocus                     Boolean                    @default(true)
  hasSeenFocusOnboarding          Boolean                    @default(false)
  brand                           Brand                      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user                            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  internProfile                   InternProfile?
  memberOnboardingProfile         MemberOnboardingProfile?
  agreementAcceptances            AgreementAcceptance[]
  onboardingSteps                 MemberOnboardingStep[]
  timecardEntries                 TimecardEntry[]
  timecardSessions                TimecardSession[]
  contractorInvoices              ContractorInvoice[]
  careerPathSteps                 CareerPathStep[]
  credentialBadges                MemberCredentialBadge[]
  memberDocuments                 MemberDocument[]           @relation("MemberDocuments")
  uploadedMemberDocuments         MemberDocument[]           @relation("MemberDocumentUploadedBy")
  memberAuditEvents               MemberAuditEvent[]         @relation("MemberAuditEvents")
  changedMemberAuditEvents        MemberAuditEvent[]         @relation("MemberAuditChangedBy")
  createdMemberOnboardingProfiles MemberOnboardingProfile[]  @relation("MemberOnboardingCreatedBy")
  updatedMemberOnboardingProfiles MemberOnboardingProfile[]  @relation("MemberOnboardingUpdatedBy")
  createdOnboardingInvites        OnboardingInvite[]         @relation("OnboardingInviteCreatedBy")
  linkedOnboardingInvite          OnboardingInvite?          @relation("OnboardingInviteLinkedMember")
  onboardingFlowAssignments       OnboardingFlowAssignment[]
  onboardingStepQuestions         OnboardingStepQuestion[]
  onboardingStepUploads           OnboardingStepUpload[]
  assignedTickets                 Ticket[]                   @relation("AssignedTickets")
  ticketComments                  TicketComment[]            @relation("TicketCommentAuthor")
  createdMeetings                 TeamMeeting[]              @relation("MeetingCreator")
  meetingAccess                   TeamMeetingAccess[]
  standardsChecks                 StandardsCheck[]
  reviewedStandardsChecks         StandardsCheck[]           @relation("StandardsCheckReviewedBy")
  dailyLogs                       DailyLog[]
  logItems                        LogItem[]
  focusQuotes                     FocusQuote[]
  focusQuoteSetting               FocusQuoteSetting?
  attendanceRecords               AttendanceRecord[]
  taskRecords                     TaskRecord[]
  assignedEngagements             Engagement[]               @relation("EngagementAssignedOwner")
  reviewedEngagements             Engagement[]               @relation("EngagementInternalReviewer")
  createdEngagements              Engagement[]               @relation("EngagementCreatedBy")
  sentReviewRequests              ReviewRequest[]            @relation("ReviewRequestSentBy")
  createdContentCalendarItems     ContentCalendarItem[]      @relation("ContentCalendarItemCreatedBy")
  createdPipelines                Pipeline[]                 @relation("PipelineCreatedBy")
  createdClientIntakeInvites      ClientIntakeInvite[]       @relation("ClientIntakeInviteCreatedBy")
  createdAt                       DateTime                   @default(now())
  updatedAt                       DateTime                   @updatedAt

  @@unique([brandId, userId])
  @@unique([brandId, employeeNumber])
  @@index([brandId, status, role])
  @@index([userId, status])
}

model BrandTheme {
  id                         String   @id @default(cuid())
  brandId                    String   @unique
  logoUrl                    String?
  logoMarkUrl                String?
  logoDarkUrl                String?
  logoMarkDarkUrl            String?
  sidebarLogoType            String   @default("mark")
  logoAlt                    String?
  mode                       String   @default("system")
  themePreset                String   @default("brand-colors")
  lightColor                 String   @default("#17324d") @map("primaryColor")
  darkColor                  String?
  accentColor                String   @default("#d79b3b")
  backgroundColor            String   @default("#f7f8fa")
  foregroundColor            String   @default("#17202a")
  supportEmail               String?
  monthlyViewsGoal           Int?
  monthlyClicksGoal          Int?
  avgWatchDurationGoal       Int?
  monthlyKeyEventsGoal       Int?
  ga4PropertyId              String?
  ga4HostName                String?
  youtubeChannelId           String?
  youtubeHandle              String?
  youtubeWatchPercentageGoal Float?
  websiteEngagedSessionsGoal Int?
  monthlyReviewRequestsGoal  Int?
  reviewOpenRateGoal         Int?
  reviewFiveStarRateGoal     Int?
  monthlyOffersSentGoal      Int?
  monthlyOffersAcceptedGoal  Int?
  proposalFeaturedVideoUrl   String?
  proposalFeaturedImageUrl   String?
  proposalLightColor         String? @map("proposalPrimaryColor")
  proposalAccentColor        String?
  accentForegroundColor      String   @default("#ffffff")
  brand                      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model BrandToolLink {
  id        String   @id @default(cuid())
  brandId   String
  key       String
  label     String
  url       String
  sortOrder Int      @default(0)
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brandId, key])
  @@index([brandId, sortOrder])
}

model BrandMediaFolder {
  id        String       @id @default(cuid())
  brandId   String
  name      String
  sortOrder Int          @default(0)
  brand     Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  media     BrandMedia[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([brandId, sortOrder])
}

model BrandMedia {
  id        String            @id @default(cuid())
  brandId   String
  folderId  String?
  name      String
  type      String // "video" | "image"
  url       String
  sortOrder Int               @default(0)
  brand     Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  folder    BrandMediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([brandId, sortOrder])
  @@index([brandId, folderId])
}

model BrandDiscount {
  id           String    @id @default(cuid())
  brandId      String
  contactId    String?
  name         String
  kind         String
  percent      Int       @default(10)
  amount       Decimal   @default(250) @db.Decimal(12, 2)
  title        String    @default("")
  details      String    @default("") @db.Text
  activationMode       String    @default("held")
  activationDelayDays  Int       @default(0)
  presentedAt          DateTime?
  deadlineMode         String    @default("relative")
  durationDays         Int       @default(14)
  deadlineDate         DateTime?
  active               Boolean   @default(true)
  sortOrder    Int       @default(0)
  brand        Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  contact      Contact?  @relation("BrandDiscountContact", fields: [contactId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([brandId, active, sortOrder])
  @@index([contactId])
}

// ─── Member profile data ─────────────────────────────────────────────────────

model InternProfile {
  id               String          @id @default(cuid())
  membershipId     String          @unique
  displayTitle     String?
  primaryEmail     String?
  timezone         String?
  startDate        DateTime?
  payRateUsd       Decimal?        @db.Decimal(10, 2)
  weeklyHoursCap   Decimal?        @db.Decimal(6, 2)
  nextRoleTitle    String?
  nextReviewDate   DateTime?
  nextLevelRateUsd Decimal?        @db.Decimal(10, 2)
  availability     String?
  workDays         String?
  workStartTime    String?
  workEndTime      String?
  telegramHandle   String?
  headshotUrl      String?
  shortBio         String?
  cohortLabel      String?
  deviceInfo       String?
  experienceNotes  String?
  goals            String?
  membership       BrandMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model MemberOnboardingProfile {
  id                         String                      @id @default(cuid())
  membershipId               String                      @unique
  legalFirstName             String
  legalLastName              String
  preferredName              String?
  dateOfBirth                DateTime?
  companyEmail               String?
  personalEmail              String?
  personalPhone              String?
  emergencyContactName       String?
  emergencyContactPhone      String?
  addressLine1               String?
  addressLine2               String?
  city                       String?
  region                     String?
  postalCode                 String?
  countryCode                String?
  engagementType             MemberEngagementType?
  memberRole                 MemberRoleProfile?
  riskLevel                  MemberRiskLevel?
  i9Required                 Boolean                     @default(false)
  i9Status                   MemberI9Status              @default(NOT_STARTED)
  i9DocumentTypes            Json?
  i9VerifiedAt               DateTime?
  w4Status                   MemberTaxStatus             @default(NOT_REQUIRED)
  w9Status                   MemberTaxStatus             @default(NOT_REQUIRED)
  tinLast4                   String?
  tinType                    MemberTinType?
  paymentMethod              MemberPaymentMethod?
  paymentEmailOrHandle       String?
  bankAccountToken           String?
  payCurrency                String                      @default("USD")
  payRate                    Float?
  payCadence                 MemberPayCadence?
  ndaAccepted                Boolean                     @default(false)
  ndaAcceptedAt              DateTime?
  handbookAccepted           Boolean                     @default(false)
  handbookAcceptedAt         DateTime?
  dataSecurityAccepted       Boolean                     @default(false)
  dataSecurityAcceptedAt     DateTime?
  contractAccepted           Boolean                     @default(false)
  contractAcceptedAt         DateTime?
  relationshipType           String?
  contractorType             String?
  w9QBAck                    Boolean                     @default(false)
  w9QBStatus                 String                      @default("NOT_SENT")
  w9QBNotes                  String?
  availableStartDate         DateTime?
  hoursPerWeek               Float?
  workingDays                Json?
  typicalHoursStart          String?
  typicalHoursEnd            String?
  timezone                   String?
  scheduleConflicts          String?
  canWorkUrgent              Boolean                     @default(false)
  canWorkWeekends            Boolean                     @default(false)
  scheduleNotes              String?
  scheduleAck                Boolean                     @default(false)
  paymentAck                 Boolean                     @default(false)
  paymentArrangement         String?
  projectNameProposal        String?
  projectAmountExpected      Float?
  projectDeadlineExpected    DateTime?
  projectNotesContractor     String?
  adminStatus                String                      @default("INVITED")
  sowRequired                Boolean                     @default(false)
  sowSent                    Boolean                     @default(false)
  sowSigned                  Boolean                     @default(false)
  approvedForWork            Boolean                     @default(false)
  adminNotes                 String?
  backgroundCheckRequired    Boolean                     @default(false)
  backgroundCheckConsent     Boolean                     @default(false)
  backgroundCheckConsentAt   DateTime?
  backgroundCheckStatus      MemberBackgroundCheckStatus @default(NOT_REQUIRED)
  backgroundCheckProviderRef String?
  needsQBOAccess             Boolean                     @default(false)
  needsEmailAccount          Boolean                     @default(false)
  needsTelegramAccess        Boolean                     @default(false)
  onboardingStatus           MemberOnboardingStatus      @default(INCOMPLETE)
  createdByMembershipId      String?
  updatedByMembershipId      String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  membership                 BrandMembership             @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdBy                  BrandMembership?            @relation("MemberOnboardingCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  updatedBy                  BrandMembership?            @relation("MemberOnboardingUpdatedBy", fields: [updatedByMembershipId], references: [id], onDelete: SetNull)

  @@map("member_onboarding_profiles")
}

model MemberDocument {
  id                     String             @id @default(cuid())
  membershipId           String
  docType                MemberDocumentType
  storageKey             String
  url                    String?
  checksum               String?
  uploadedByMembershipId String?
  uploadedAt             DateTime           @default(now())
  membership             BrandMembership    @relation("MemberDocuments", fields: [membershipId], references: [id], onDelete: Cascade)
  uploadedBy             BrandMembership?   @relation("MemberDocumentUploadedBy", fields: [uploadedByMembershipId], references: [id], onDelete: SetNull)

  @@index([membershipId, uploadedAt])
  @@map("member_documents")
}

model MemberAuditEvent {
  id                    String           @id @default(cuid())
  membershipId          String
  eventKey              String
  previousValue         String?
  newValue              String?
  changedByMembershipId String?
  createdAt             DateTime         @default(now())
  membership            BrandMembership  @relation("MemberAuditEvents", fields: [membershipId], references: [id], onDelete: Cascade)
  changedBy             BrandMembership? @relation("MemberAuditChangedBy", fields: [changedByMembershipId], references: [id], onDelete: SetNull)

  @@index([membershipId, createdAt])
  @@map("member_audit_events")
}

model OnboardingInvite {
  id                      String                 @id @default(cuid())
  brandId                 String
  tokenHash               String
  email                   String
  recipientName           String?
  role                    MemberRoleProfile
  onboardingTrack         OnboardingTrack
  engagementType          MemberEngagementType
  countryCode             String
  riskLevel               MemberRiskLevel
  backgroundCheckRequired Boolean
  needsQBOAccess          Boolean                @default(false)
  needsEmailAccount       Boolean                @default(false)
  needsTelegramAccess     Boolean                @default(true)
  uiVariant               String?
  lockedFields            Json?
  expiresAt               DateTime
  openedAt                DateTime?
  usedAt                  DateTime?
  createdByMembershipId   String?
  linkedMembershipId      String?                @unique
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  createdByMembership     BrandMembership?       @relation("OnboardingInviteCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  linkedMembership        BrandMembership?       @relation("OnboardingInviteLinkedMember", fields: [linkedMembershipId], references: [id], onDelete: SetNull)
  submissions             OnboardingSubmission[]

  @@index([brandId, email, createdAt])
}

model OnboardingSubmission {
  id                       String           @id @default(cuid())
  inviteId                 String
  submittedAt              DateTime         @default(now())
  ipAddress                String?
  userAgent                String?
  payloadSnapshotEncrypted String?
  invite                   OnboardingInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
}

model AgreementAcceptance {
  id               String          @id @default(cuid())
  membershipId     String
  agreementKey     String
  agreementVersion String
  acceptedAt       DateTime        @default(now())
  membership       BrandMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, agreementKey, agreementVersion])
}

model MemberOnboardingStep {
  id           String          @id @default(cuid())
  membershipId String
  stepKey      String
  completedAt  DateTime?
  membership   BrandMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, stepKey])
}

model OnboardingStepConfig {
  id                       String   @id @default(cuid())
  stepKey                  String   @unique
  titleOverride            String?
  descriptionOverride      String?
  streamIdOverride         String?
  linkHrefOverride         String?
  linkLabelOverride        String?
  agreementVersionOverride String?
  updatedAt                DateTime @updatedAt
  createdAt                DateTime @default(now())
}

model OnboardingFlow {
  id                String                     @id @default(cuid())
  brandId           String
  key               String
  label             String
  audience          OnboardingFlowAudience
  sortOrder         Int                        @default(100)
  isActive          Boolean                    @default(true)
  requireSequential Boolean                    @default(false)
  steps             OnboardingFlowStepConfig[]
  customSteps       OnboardingFlowCustomStep[]
  assignments       OnboardingFlowAssignment[]
  questions         OnboardingStepQuestion[]
  stepUploads       OnboardingStepUpload[]
  stepOrder         OnboardingFlowStepOrder[]
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@unique([brandId, key])
  @@index([brandId, audience, isActive, sortOrder])
}

model OnboardingFlowStepConfig {
  id                       String         @id @default(cuid())
  flowId                   String
  stepKey                  String
  titleOverride            String?
  descriptionOverride      String?
  streamIdOverride         String?
  linkHrefOverride         String?
  linkLabelOverride        String?
  assetHrefOverride        String?
  assetLabelOverride       String?
  objectivesOverride       String?
  agreementVersionOverride String?
  requiredOverride         Boolean?
  blockingOverride         Boolean?
  isEnabledOverride        Boolean?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  flow                     OnboardingFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([flowId, stepKey])
  @@index([flowId, stepKey])
}

model OnboardingFlowCustomStep {
  id               String             @id @default(cuid())
  flowId           String
  title            String
  description      String?
  type             OnboardingStepType
  required         Boolean            @default(false)
  blocking         Boolean            @default(false)
  sortOrder        Int                @default(1000)
  streamId         String?
  linkHref         String?
  linkLabel        String?
  assetHref        String?
  assetLabel       String?
  objectives       String?
  agreementKey     String?
  agreementVersion String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  flow             OnboardingFlow     @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@index([flowId, sortOrder, createdAt])
}

model OnboardingFlowAssignment {
  id                     String          @id @default(cuid())
  membershipId           String
  flowId                 String
  isActive               Boolean         @default(true)
  reviewModeEnabled      Boolean         @default(false)
  assignedByMembershipId String?
  assignedAt             DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  membership             BrandMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  flow                   OnboardingFlow  @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([membershipId, flowId])
  @@index([flowId, isActive])
  @@index([membershipId, isActive])
}

model OnboardingStepQuestion {
  id                     String                   @id @default(cuid())
  membershipId           String
  flowId                 String
  stepKey                String
  questionText           String
  status                 OnboardingQuestionStatus @default(OPEN)
  adminReplyText         String?
  askedAt                DateTime                 @default(now())
  answeredAt             DateTime?
  resolvedAt             DateTime?
  answeredByMembershipId String?
  updatedAt              DateTime                 @updatedAt
  membership             BrandMembership          @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  flow                   OnboardingFlow           @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([membershipId, flowId, stepKey])
  @@index([flowId, status])
  @@index([membershipId, status])
}

model OnboardingStepUpload {
  id              String          @id @default(cuid())
  membershipId    String
  flowId          String
  stepKey         String
  storageProvider String          @default("SUPABASE")
  bucket          String
  storagePath     String
  fileName        String
  mimeType        String?
  sizeBytes       Int
  publicUrl       String
  uploadedAt      DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  membership      BrandMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  flow            OnboardingFlow  @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([membershipId, flowId, stepKey])
  @@index([flowId, membershipId])
}

model OnboardingFlowStepOrder {
  id        String         @id @default(cuid())
  flowId    String
  stepKey   String
  sortOrder Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  flow      OnboardingFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([flowId, stepKey])
  @@index([flowId, sortOrder])
}

// ─── Timekeeping & payroll ───────────────────────────────────────────────────

model TimecardEntry {
  id           String          @id @default(cuid())
  membershipId String
  workDate     DateTime
  hours        Decimal         @db.Decimal(5, 2)
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  membership   BrandMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId, workDate])
}

model TimecardSession {
  id           String          @id @default(cuid())
  membershipId String
  clockInAt    DateTime
  clockOutAt   DateTime?
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  membership   BrandMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId, clockInAt])
  @@index([membershipId, clockOutAt])
}

model ContractorInvoice {
  id                 String          @id @default(cuid())
  membershipId       String
  invoiceNumber      String          @unique
  status             InvoiceStatus   @default(DRAFT)
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  totalHours         Decimal         @db.Decimal(10, 2)
  billingRateUsd     Decimal         @db.Decimal(10, 2)
  billableAmountUsd  Decimal         @db.Decimal(12, 2)
  lineItems          Json
  pdfData            Bytes?
  submittedAt        DateTime?
  approvedAt         DateTime?
  paidAt             DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  membership         BrandMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId, status])
  @@index([membershipId, billingPeriodStart, billingPeriodEnd])
}

model CareerPathStep {
  id                 String          @id @default(cuid())
  membershipId       String
  stepOrder          Int
  title              String
  billingRateUsd     Decimal         @db.Decimal(10, 2)
  weeklyHoursCap     Decimal         @db.Decimal(6, 2)
  monthlyBenefitsUsd Decimal         @default(0) @db.Decimal(10, 2)
  notes              String?
  isActive           Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  membership         BrandMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, stepOrder])
  @@index([membershipId, isActive])
}

// ─── Credential badges (platform-level) ─────────────────────────────────────

model CredentialBadge {
  id          String                  @id @default(cuid())
  key         String                  @unique
  label       String
  icon        CredentialIcon
  ribbonStyle String                  @default("TRI_STRIPE")
  colorA      String                  @default("#0f172a")
  colorB      String                  @default("#f8d773")
  colorC      String?
  sortOrder   Int                     @default(0)
  isActive    Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  members     MemberCredentialBadge[]

  @@index([isActive, sortOrder])
}

model MemberCredentialBadge {
  id                    String          @id @default(cuid())
  membershipId          String
  badgeId               String
  awardedAt             DateTime        @default(now())
  expiresAt             DateTime?
  notes                 String?
  awardedByMembershipId String?
  membership            BrandMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  badge                 CredentialBadge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([membershipId, badgeId])
  @@index([membershipId])
  @@index([badgeId])
}

// ─── App notices ──────────────────────────────────────────────────────────────

model AppNotice {
  id         String     @id @default(cuid())
  brandId    String
  title      String
  body       String
  targetRole BrandRole?
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([brandId, isActive, targetRole])
}

// ─── Client management ────────────────────────────────────────────────────────

model TicketClient {
  id                           String               @id @default(cuid())
  brandId                      String
  code                         String
  name                         String?
  isActive                     Boolean              @default(true)
  businessLegalName            String?
  entityType                   String?
  principalAddressLine1        String?
  principalAddressLine2        String?
  principalAddressCity         String?
  principalAddressState        String?
  principalAddressPostalCode   String?
  stateOfFormation             String?
  principalAddress             String?
  primaryContactPhone          String?
  authorizedCommunicationEmail String?
  noticesEmail                 String?
  preferredInvoicingEmail      String?
  clientIntakeInvites          ClientIntakeInvite[]
  reviewRequests               ReviewRequest[]
  tickets                      Ticket[]
  meetings                     TeamMeetingClient[]
  contacts                     ClientContact[]
  leads                        MeetingLead[]
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt

  @@unique([brandId, code])
  @@index([brandId, isActive])
}

model ClientIntakeInvite {
  id                    String           @id @default(cuid())
  clientId              String
  tokenHash             String
  expiresAt             DateTime
  usedAt                DateTime?
  createdByMembershipId String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  client                TicketClient     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy             BrandMembership? @relation("ClientIntakeInviteCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
}

// ─── Reviews ──────────────────────────────────────────────────────────────────

model ReviewRequest {
  id                 String           @id @default(cuid())
  brandId            String
  clientId           String?
  token              String           @unique @default(cuid())
  channel            ReviewChannel
  recipientPhone     String?
  recipientEmail     String?
  recipientName      String?
  sentAt             DateTime         @default(now())
  lastReminderAt     DateTime?
  openedAt           DateTime?
  clickedAt          DateTime?
  outcome            ReviewOutcome?
  feedbackRating     Int?
  feedbackText       String?
  sentByMembershipId String?
  contactId          String?
  campaignId         String?
  client             TicketClient?    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sentBy             BrandMembership? @relation("ReviewRequestSentBy", fields: [sentByMembershipId], references: [id], onDelete: SetNull)
  contact            Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  campaign           Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([brandId, createdAt])
  @@index([clientId, createdAt])
  @@index([token])
  @@index([campaignId])
  @@index([contactId])
}

model Campaign {
  id          String            @id @default(cuid())
  brandId     String
  name        String
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  contacts    CampaignContact[]
  requests    ReviewRequest[]

  @@index([brandId])
}

model CampaignContact {
  id         String   @id @default(cuid())
  campaignId String
  contactId  String
  addedAt    DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([campaignId])
}

// ─── Contacts & CRM ──────────────────────────────────────────────────────────

model Contact {
  id             String               @id @default(cuid())
  brandId        String
  name           String
  firstName      String?
  lastName       String?
  email          String?
  secondaryEmail String?
  phoneE164      String?
  businessEmail  String?
  personalEmail  String?
  phoneNumber    String?
  company        String?
  notes          String?
  roleTitle      String?
  isActive       Boolean              @default(true)
  brand          Brand                @relation("CrmBrandContacts", fields: [brandId], references: [id], onDelete: Cascade)
  clientLinks    ClientContact[]
  customerLinks  CustomerContact[]
  leadLinks      LeadContact[]
  meetings       TeamMeetingContact[]
  campaignLinks  CampaignContact[]
  reviewRequests ReviewRequest[]
  tagLinks       ContactTagLink[]
  brandLinks     ContactBrandLink[]
  brandDiscounts BrandDiscount[]      @relation("BrandDiscountContact")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([brandId, id])
  @@index([brandId, isActive, name])
  @@index([brandId, email])
  @@index([brandId, company])
}

model ContactBrandLink {
  id             String   @id @default(cuid())
  contactId      String
  relatedBrandId String
  createdAt      DateTime @default(now())
  contact        Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  relatedBrand   Brand    @relation("ContactRelatedBrands", fields: [relatedBrandId], references: [id], onDelete: Cascade)

  @@unique([contactId, relatedBrandId])
  @@index([relatedBrandId])
  @@map("contact_brand_links")
}

model ContactTag {
  id                 String                 @id @default(cuid())
  brandId            String
  key                String
  label              String
  kind               ContactTagKind         @default(CUSTOM)
  color              String?
  isActive           Boolean                @default(true)
  sortOrder          Int                    @default(100)
  brand              Brand                  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  contacts           ContactTagLink[]
  automations        ContactTagAutomation[]
  catalogServices    CatalogService[]
  catalogServiceTags CatalogServiceTag[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@unique([brandId, key])
  @@index([brandId, isActive, sortOrder])
  @@map("contact_tags")
}

model ContactTagLink {
  id        String     @id @default(cuid())
  contactId String
  tagId     String
  createdAt DateTime   @default(now())
  contact   Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       ContactTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([contactId, tagId])
  @@index([tagId, createdAt])
  @@map("contact_tag_links")
}

model ContactTagAutomation {
  id         String         @id @default(cuid())
  brandId    String
  tagId      String
  pipelineId String
  stageId    String?
  isActive   Boolean        @default(true)
  brand      Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  tag        ContactTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  pipeline   Pipeline       @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage      PipelineStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([tagId, pipelineId])
  @@index([brandId, isActive])
  @@map("contact_tag_automations")
}

model ClientContact {
  id        String       @id @default(cuid())
  clientId  String
  contactId String
  createdAt DateTime     @default(now())
  client    TicketClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([clientId, contactId])
  @@index([contactId, createdAt])
}

model LeadContact {
  id        String      @id @default(cuid())
  brandId   String
  leadId    String
  contactId String
  createdAt DateTime    @default(now())
  brand     Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  lead      MeetingLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact   Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([leadId, contactId])
  @@index([brandId, contactId, createdAt])
}

// ─── Tickets ──────────────────────────────────────────────────────────────────

model Ticket {
  id                   String                  @id @default(cuid())
  brandId              String
  ticketNumber         String?
  clientId             String
  urgency              TicketUrgency           @default(MEDIUM)
  description          String
  status               TicketStatus            @default(NOT_STARTED)
  openedOn             DateTime
  deadline             DateTime
  closedOn             DateTime?
  assignedMembershipId String?
  assignedNameLegacy   String?
  type                 TicketType
  roleNeeded           TicketRoleNeeded
  coordinationLevel    TicketCoordinationLevel @default(NONE)
  ticketFolderUrl      String?
  postBriefUrl         String?
  notes                String?
  importSource         String?
  importKey            String?                 @unique
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  client               TicketClient            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  assignedMembership   BrandMembership?        @relation("AssignedTickets", fields: [assignedMembershipId], references: [id], onDelete: SetNull)
  comments             TicketComment[]

  @@index([brandId, status, clientId])
  @@index([assignedMembershipId, status])
  @@index([deadline])
}

model TicketComment {
  id                 String          @id @default(cuid())
  ticketId           String
  authorMembershipId String
  body               String
  createdAt          DateTime        @default(now())
  ticket             Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorMembership   BrandMembership @relation("TicketCommentAuthor", fields: [authorMembershipId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([authorMembershipId, createdAt])
}

// ─── Team meetings ────────────────────────────────────────────────────────────

model TeamMeeting {
  id                    String               @id @default(cuid())
  brandId               String
  title                 String
  meetingUrl            String
  meetingDate           DateTime
  provider              String               @default("FIREFLIES")
  notes                 String?
  externalId            String?              @unique
  source                String               @default("manual")
  createdByMembershipId String
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  createdBy             BrandMembership      @relation("MeetingCreator", fields: [createdByMembershipId], references: [id], onDelete: Cascade)
  accesses              TeamMeetingAccess[]
  clients               TeamMeetingClient[]
  leads                 TeamMeetingLead[]
  tags                  TeamMeetingTag[]
  contacts              TeamMeetingContact[]

  @@index([brandId, meetingDate])
  @@index([createdByMembershipId])
}

model TeamMeetingAccess {
  id           String          @id @default(cuid())
  meetingId    String
  membershipId String
  createdAt    DateTime        @default(now())
  meeting      TeamMeeting     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  membership   BrandMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([meetingId, membershipId])
  @@index([membershipId, createdAt])
}

model TeamMeetingClient {
  id        String       @id @default(cuid())
  meetingId String
  clientId  String
  createdAt DateTime     @default(now())
  meeting   TeamMeeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  client    TicketClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([meetingId, clientId])
  @@index([clientId, createdAt])
}

model MeetingLead {
  id                  String                  @id @default(cuid())
  brandId             String
  name                String
  company             String?
  email               String?
  clientId            String?
  kind                LeadKind                @default(LEAD)
  bookkeepingCategory LeadBookkeepingCategory @default(SMALL_BUSINESS)
  expectedServices    String?
  notes               String?
  isActive            Boolean                 @default(true)
  client              TicketClient?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  meetings            TeamMeetingLead[]
  contacts            LeadContact[]
  pipelineItems       PipelineItem[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([brandId, clientId, createdAt])
}

model TeamMeetingLead {
  id        String      @id @default(cuid())
  meetingId String
  leadId    String
  createdAt DateTime    @default(now())
  meeting   TeamMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  lead      MeetingLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([meetingId, leadId])
  @@index([leadId, createdAt])
}

model MeetingTag {
  id        String           @id @default(cuid())
  brandId   String
  key       String
  label     String
  isActive  Boolean          @default(true)
  sortOrder Int              @default(0)
  meetings  TeamMeetingTag[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([brandId, key])
  @@index([brandId, isActive, sortOrder])
}

model TeamMeetingTag {
  id        String      @id @default(cuid())
  meetingId String
  tagId     String
  createdAt DateTime    @default(now())
  meeting   TeamMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  tag       MeetingTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([meetingId, tagId])
  @@index([tagId, createdAt])
}

model TeamMeetingContact {
  id        String      @id @default(cuid())
  meetingId String
  contactId String
  createdAt DateTime    @default(now())
  meeting   TeamMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  contact   Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([meetingId, contactId])
  @@index([contactId, createdAt])
}

// ─── Pipeline ─────────────────────────────────────────────────────────────────

model Pipeline {
  id                    String                 @id @default(cuid())
  brandId               String
  key                   String
  name                  String
  type                  PipelineType           @default(CUSTOM)
  description           String?
  isActive              Boolean                @default(true)
  createdByMembershipId String?
  createdBy             BrandMembership?       @relation("PipelineCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  stages                PipelineStage[]
  items                 PipelineItem[]
  tagAutomations        ContactTagAutomation[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([brandId, key])
  @@index([brandId, type, isActive])
}

model PipelineStage {
  id              String                 @id @default(cuid())
  pipelineId      String
  key             String
  name            String
  description     String?
  sortOrder       Int                    @default(100)
  valueMultiplier Decimal                @default(0.01) @db.Decimal(6, 3)
  isActive        Boolean                @default(true)
  isTerminal      Boolean                @default(false)
  pipeline        Pipeline               @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  items           PipelineItem[]
  tagAutomations  ContactTagAutomation[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@unique([pipelineId, key])
  @@index([pipelineId, sortOrder, isActive])
}

model PipelineItem {
  id           String        @id @default(cuid())
  pipelineId   String
  stageId      String
  leadId       String
  baseValueUsd Decimal       @default(0) @db.Decimal(12, 2)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  pipeline     Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage        PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  lead         MeetingLead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([pipelineId, leadId])
  @@index([stageId, isActive])
  @@index([pipelineId, isActive])
}

// ─── Content & analytics ─────────────────────────────────────────────────────

model ContentCalendarItem {
  id                    String                @id @default(cuid())
  brandId               String
  title                 String
  notes                 String?
  status                ContentCalendarStatus @default(PLANNED)
  plannedPublishDate    DateTime
  producedAt            DateTime?
  actualPublishDate     DateTime?
