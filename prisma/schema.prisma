generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ─── Platform-level enums ────────────────────────────────────────────────────

enum PlatformRole {
  NONE
  ADMIN
  OWNER
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  FORMER
}

enum BrandStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  OFFBOARDING
  DELETED
}

enum BrandRole {
  VIEWER
  MEMBER
  ADMIN
  OWNER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum DomainPurpose {
  APP
  WEBSITE
}

enum DomainStatus {
  PENDING
  VERIFIED
  DISABLED
}

// ─── BC-originated enums ─────────────────────────────────────────────────────

enum AccountType {
  CONTRACTOR
  INTERN
  ADMIN
  STAFF
}

enum InvoiceStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PAID
}

