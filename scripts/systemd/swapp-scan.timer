[Unit]
Description=SWapp Scan button poller timer (every minute)

[Timer]
# Every 20 seconds: a pressed Scan must move off "Waiting" fast. The 15-minute
# auto scan is decided by the poller itself, so cadence changes don't affect it.
OnCalendar=*:*:0/20
Persistent=true

[Install]
WantedBy=timers.target
