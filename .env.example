# PostgreSQL runtime pool and direct migration connections
DATABASE_URL=
DIRECT_DATABASE_URL=

# Auth.js
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_EMAIL_FROM=
# Provider-specific transactional email credentials will be added when the
# delivery provider is selected. Do not expose them as NEXT_PUBLIC variables.

# Canonical operator hostname used when a client hostname is unavailable
PLATFORM_BASE_URL=http://localhost:3000

# Local-only hostname override, for example app.bookkeepingconroe.localhost
DEV_BRAND_HOST=
