# PostgreSQL runtime pool and direct migration connections
DATABASE_URL=
DIRECT_DATABASE_URL=

# Auth.js
AUTH_SECRET=
# Do not set AUTH_URL or NEXTAUTH_URL. This is intentionally a multi-host deployment.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Stable OAuth proxy base. Production: https://admin.southwestdigital.io/api/auth
AUTH_REDIRECT_PROXY_URL=
AUTH_EMAIL_FROM=
AUTH_EMAIL_SERVER=
AUTH_RESEND_KEY=

# Canonical operator hostname used when a client hostname is unavailable.
# Production: https://admin.southwestdigital.io
PLATFORM_BASE_URL=http://localhost:3000

# Local-only hostname override (hostname only, no protocol).
# Leave empty to use localhost as the operator host (PLATFORM_BASE_URL).
# Set to a verified app hostname to preview that brand's login locally,
# e.g. app.southwestdigital.io or app.contigoaccounting.com
DEV_BRAND_HOST=

# Guarded one-time/rehearsal seed. Keep disabled outside an intentional run.
ALLOW_INITIAL_BRAND_SEED=false
INITIAL_BOOKKEEPING_OWNER_EMAIL=thomas@bookkeepingconroe.com
INITIAL_PLATFORM_OWNER_EMAIL=admin@southwestdigital.io
INITIAL_DAGNY_EMAIL=dagnymotor@gmail.com
